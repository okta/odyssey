# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not,
# so never put a real key here.
#
# Nothing loads `.env` automatically. There is no direnv in the container and
# `.envrc` does not source it, so read it in explicitly before a command that
# needs a key:
#
#   set -a; . ./.env; set +a
#
# A worktree created through the WorktreeCreate hook gets a symlink to the main
# checkout's `.env`, so the same keys are available there without copying the
# secret again. See `.claude/scripts/setup-worktree-deps.sh`.

# Applitools, for the visual regression suite (`yarn test:vrt`).
APPLITOOLS_API_KEY=

# Anthropic, for `@okta/extractor`. With this set the extractor calls the API
# directly. Without it, it falls back to shelling out to the `claude` CLI, which
# is slower, costs more per call, and is a genuinely different code path, so an
# extractor run that behaves oddly is worth re-checking with the key present.
#
# Set it to EMPTY rather than to a wrong value. Absent an explicit `--auth-mode`,
# `createLlmClient` picks with `resolvedKey ? "api-key" : "claude-cli"`, so a key
# that is present but invalid selects the API path and then 401s on every single
# prompt, where an empty one falls back cleanly.
ANTHROPIC_API_KEY=

# Base URL for the Anthropic API. Leave empty to reach Anthropic directly.
#
# If the key provider requires a custom Anthropic-compatible endpoint, set this
# to the base URL it provides.
#
# Read by the Anthropic SDK itself, so nothing in this repo has to pass it
# through.
ANTHROPIC_BASE_URL=
