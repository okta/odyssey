{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "eslint"
      }
    }
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/**/*.mdx",
      "!{projectRoot}/**/LICENSE*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.@(js|jsx|ts|tsx)",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*"
    ],
    "formatting": [
      "{workspaceRoot}/**/*",
      "!{workspaceRoot}/**/dist/**/*",
      "!{workspaceRoot}/**/*.generated.*"
    ],
    "full-source": [
      "{projectRoot}/**/*",
      "!{projectRoot}/**/LICENSE*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.bacon.yml",
      "{workspaceRoot}/scripts/setup.sh",
      "{workspaceRoot}/scripts/util.sh",
      "{workspaceRoot}/yarn.lock",
      "{workspaceRoot}/.yarnrc.yml",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/babel.config.*",
      "{workspaceRoot}/.browserslistrc",
      "{workspaceRoot}/package.json",
      {
        "env": "NODE_ENV"
      },
      {
        "env": "BROWSERSLIST_ENV"
      },
      {
        "env": "ODYSSEY_BUILD_MODE"
      },
      {
        "env": "ODYSSEY_ICONS_TYPE"
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/src/properties/ts"
      ],
      "cache": true
    },
    "build:storybook": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "inputs": [
        "full-source",
        "^production",
        {
          "env": "BUILD_BASE"
        }
      ],
      "outputs": [
        "{projectRoot}/storybook-static"
      ],
      "cache": true
    },
    "eslint": {
      "dependsOn": [
        "^build"
      ]
    },
    "generate:i18n": {
      "dependsOn": [
        {
          "projects": [
            "@okta/odyssey-cli"
          ],
          "target": "build"
        }
      ]
    },
    "generate:i18n:pseudoLocaleProperties": {
      "dependsOn": [
        {
          "projects": [
            "@okta/odyssey-cli"
          ],
          "target": "build"
        }
      ],
      "inputs": [
        "default",
        {
          "env": "ODYSSEY_I18N_REPO_NAME"
        }
      ],
      "cache": true
    },
    "playwright-install": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    }
  },
  "analytics": false
}
