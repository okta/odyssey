{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "eslint"
      }
    }
  ],
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/**/*.mdx",
      "!{projectRoot}/**/LICENSE*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.@(js|jsx|ts|tsx)",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*"
    ],
    "formatting": [
      "{workspaceRoot}/**/*",
      "!{workspaceRoot}/**/dist/**/*",
      "!{workspaceRoot}/**/*.generated.*"
    ],
    "full-source": [
      "{projectRoot}/**/*",
      "!{projectRoot}/**/LICENSE*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/scripts/setup.sh",
      "{workspaceRoot}/scripts/util.sh",
      "{workspaceRoot}/.nvmrc",
      {
        "env": "NODE_ENV"
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/src/properties/ts"
      ],
      "cache": true
    },
    "build:storybook": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "inputs": [
        "full-source",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/storybook-static"
      ],
      "cache": true
    },
    "coverage": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/scripts/unit-test.sh",
        "{workspaceRoot}/scripts/test-selection-shadow.sh",
        "{workspaceRoot}/scripts/odyssey-code-coverage.sh"
      ],
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "cache": true
    },
    "eslint": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "...",
        "{workspaceRoot}/packages/configs/odyssey-eslint-config/src/**/*",
        {
          "env": "IS_CI"
        },
        {
          "env": "IS_COMMITTING"
        },
        {
          "env": "HAS_SORTING"
        }
      ]
    },
    "generate:i18n": {
      "dependsOn": [
        {
          "projects": [
            "@okta/odyssey-cli"
          ],
          "target": "build"
        }
      ]
    },
    "generate:i18n:pseudoLocaleProperties": {
      "dependsOn": [
        {
          "projects": [
            "@okta/odyssey-cli"
          ],
          "target": "build"
        }
      ],
      "inputs": [
        "default",
        {
          "env": "ODYSSEY_I18N_REPO_NAME"
        }
      ],
      "cache": true
    },
    "playwright-install": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/scripts/unit-test.sh",
        "{workspaceRoot}/scripts/test-selection-shadow.sh",
        "{workspaceRoot}/scripts/odyssey-code-coverage.sh"
      ],
      "cache": true
    }
  },
  "analytics": false
}
