{
  "name": "@okta/odyssey-contribution-tooling",
  "version": "1.73.0",
  "nx": {
    "tags": [
      "scope:core"
    ]
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:clean": "rimraf dist",
    "build:source": "yarn vite build",
    "build:types": "tsc --project tsconfig.production.json",
    "build": "yarn build:clean && yarn build:source && yarn build:types",
    "dev:source": "yarn vite build --watch",
    "dev:types": "tsc --project tsconfig.production.json --watch",
    "dev": "yarn concurrently npm:dev:types npm:dev:source",
    "playwright-install": "yarn playwright install chromium",
    "coverage": "NODE_ENV=test vitest run --coverage --reporter=default",
    "test": "NODE_ENV=test vitest run --reporter=default",
    "typecheck": "tsc --project src/tsconfig.json --noEmit"
  },
  "dependencies": {
    "i18next": "^23.15.1",
    "react-i18next": "15.4.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@okta/odyssey-test-tooling": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "concurrently": "^9.2.1",
    "msw": "^2.10.5",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
