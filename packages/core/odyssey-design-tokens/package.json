{
  "name": "@okta/odyssey-design-tokens",
  "version": "1.73.1",
  "nx": {
    "tags": [
      "scope:core"
    ]
  },
  "description": "Design tokens for Odyssey, Okta's design system",
  "author": "Okta, Inc.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./dark": {
      "types": "./dist/dark.d.ts",
      "import": "./dist/dark.mjs",
      "require": "./dist/dark.cjs"
    },
    "./scss": "./dist/index.scss"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atko-eng/odyssey-design-system",
    "directory": "packages/core/odyssey-design-tokens"
  },
  "devDependencies": {
    "style-dictionary": "^3.9.2"
  },
  "scripts": {
    "build:check": "node scripts/checkLightAndDarkTokensMatch.mjs",
    "build:clean": "style-dictionary clean --config ./config.light.cjs && style-dictionary clean --config ./config.dark.cjs",
    "build": "yarn build:clean && style-dictionary build --config ./config.light.cjs && style-dictionary build --config ./config.dark.cjs && yarn build:check"
  }
}
