{
  "name": "@okta/odyssey-storybook",
  "version": "1.74.0",
  "description": "Documentation for Odyssey, Okta's design system",
  "nx": {
    "tags": [
      "scope:app"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "^build:storybook"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "inputs": [
          "full-source",
          "^production",
          {
            "dependentTasksOutputFiles": "**/storybook-static/**/*"
          }
        ]
      },
      "start:storybook": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "author": "Okta, Inc.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atko-eng/odyssey-design-system",
    "directory": "packages/apps/odyssey-storybook"
  },
  "devDependencies": {
    "@okta/odyssey-atlas": "workspace:*",
    "@okta/odyssey-contributions-example-components": "workspace:*",
    "@okta/odyssey-contributions-iga-components": "workspace:*",
    "@okta/odyssey-contributions-oin-components": "workspace:*",
    "@okta/odyssey-contributions-opa-components": "workspace:*",
    "@okta/odyssey-contributions-orpheus-components": "workspace:*",
    "@okta/odyssey-contributions-passwordless-components": "workspace:*",
    "@okta/odyssey-contributions-permiso-components": "workspace:*",
    "@okta/odyssey-contributions-policy-rules-components": "workspace:*",
    "@okta/odyssey-contributions-resource-access-policy-components": "workspace:*",
    "@okta/odyssey-contributions-spera-components": "workspace:*",
    "@okta/odyssey-contributions-ud-components": "workspace:*",
    "@okta/odyssey-contributions-workflows-components": "workspace:*",
    "@okta/odyssey-contributions-wp-components": "workspace:*",
    "@okta/odyssey-core-storybook": "workspace:*",
    "@okta/odyssey-labs": "workspace:*",
    "@okta/odyssey-storybook-preset": "workspace:*",
    "@okta/odyssey-typescript": "workspace:*",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/mdx": "^2.0.11",
    "@types/react": "^18.3.12",
    "http-server": "^14.1.1",
    "markdown-to-jsx": "^7.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.3",
    "typescript": "^5.9.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "build": "storybook build --output-dir dist",
    "start:storybook": "echo 'Serving the composed Storybook at http://127.0.0.1:6006' && http-server dist --port 6006 --silent -o",
    "prepack": "yarn run -T nx build @okta/odyssey-storybook",
    "typecheck": "tsc --noEmit"
  }
}
