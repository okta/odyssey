{
  "extends": "@okta/odyssey-typescript/tsconfig.node16.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext", "ES2021"],
    "sourceMap": true,
    "target": "es2020",
    "outDir": "dist",
    "rootDir": ".",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "types": ["vitest/globals"]
  },
  "include": ["src", "vitest.config.ts"]
}
